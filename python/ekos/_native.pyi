"""The native read engine (Rust, `ekos/crates/python`). Answers are JSON text."""

class EkosError(Exception): ...
class LedgerError(EkosError): ...
class QueryError(EkosError): ...
class NotFound(QueryError): ...
class NotSupported(EkosError): ...

class Ledger:
    def call(self, name: str, arguments: str, embedding: list[float] | None = None) -> str: ...
    def refresh(self) -> bool: ...
    def warnings(self) -> list[str]: ...

def open(path: str, read_scope: str | None = None) -> Ledger: ...  # noqa: A001
def reads() -> list[str]: ...
def engine_version() -> str: ...
