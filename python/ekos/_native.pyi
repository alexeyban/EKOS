"""The native read engine (Rust, `ekos/crates/python`). Results are JSON text."""

class EkosError(Exception): ...
class LedgerError(EkosError): ...
class QueryError(EkosError): ...
class NotSupported(EkosError): ...

class Ledger:
    def status(self) -> str: ...
    def search(self, query: str, mode: str, limit: int) -> str: ...
    def get(self, object_id: str) -> str: ...
    def refresh(self) -> bool: ...

def open(path: str) -> Ledger: ...  # noqa: A001
def engine_version() -> str: ...
