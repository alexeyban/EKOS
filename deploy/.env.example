# EKOS deployment settings. Copy to `deploy/.env` (gitignored) and edit.
#
#   cp deploy/.env.example deploy/.env
#
# Compose reads this file twice: for `${...}` in docker-compose.yml (EKOS_SOURCES, EKOS_PORT),
# and as the container's environment.
#
# Everything else here can instead be set by a platform owner on the console's Settings page,
# which writes /var/lib/ekos/control/console.toml (RFC 0184). A variable set in this file wins
# over that page and shows there as read-only. Secrets typed on that page need an OS keychain,
# which a container does not have: keep secrets here.

# The host directory holding the repositories and document folders to compile. It is mounted
# read-only at /sources; a project is created for a directory below it.
EKOS_SOURCES=/srv/repos

# Host port, bound to 127.0.0.1.
EKOS_PORT=8000

# ── Sign-in ───────────────────────────────────────────────────────────────────
# Two static tokens. The prefix is `EKOS_CONSOLE_` and the setting is `console_token`, so the
# doubled word is correct. Generate each with: openssl rand -hex 24
#
# Read role: browse, search, query.
EKOS_CONSOLE_CONSOLE_TOKEN=
# Read + write role: create projects, run the pipeline, review. Leave empty for a read-only
# console.
EKOS_CONSOLE_CONSOLE_WRITE_TOKEN=

# Signs the session cookie. Without it sessions end at every restart. openssl rand -hex 32
EKOS_CONSOLE_SESSION_SECRET=

# For anything shared, use OIDC instead of the tokens above; setting an issuer disables token
# sign-in. People then get access through roles granted in the console's Admin page (RFC 0180):
# viewer, reviewer, operator, admin, per tenant or per project.
# EKOS_CONSOLE_OIDC_ISSUER=https://id.example.com/realms/main
# EKOS_CONSOLE_OIDC_CLIENT_ID=ekos
# EKOS_CONSOLE_OIDC_CLIENT_SECRET=
# EKOS_CONSOLE_OIDC_REDIRECT_URI=https://ekos.example.com/api/auth/callback
# EKOS_CONSOLE_OIDC_ROLE_CLAIM=groups
# What sign-in asks the provider for. Dex, Keycloak and Okta send group membership only when
# `groups` is asked for; without it a group mapped to a claim value has no members.
# EKOS_CONSOLE_OIDC_SCOPES=openid email profile groups
# EKOS_CONSOLE_OIDC_WRITE_VALUES=ekos-operators
#
# Platform owners: e-mail addresses (or OIDC subjects), comma-separated. An owner can do
# everything, creates tenants and sets which directories each may read.
# EKOS_CONSOLE_OWNERS=you@example.com
#
# Production mode. The console then refuses to start without OIDC, an owner and a session
# secret; static tokens stop working; and nobody has access except through a granted role
# (without it, every signed-in user can read the `default` tenant, as before RFC 0180).
# EKOS_CONSOLE_PRODUCTION=true

# ── MCP servers ───────────────────────────────────────────────────────────────
# Each project in use has an `ekos mcp serve` process holding its index in memory. One starts
# on first use, stops after this many idle seconds (0 = never), and at most this many run.
# EKOS_CONSOLE_MCP_IDLE_SECONDS=900
# EKOS_CONSOLE_MCP_MAX_SERVERS=8

# ── Model providers ───────────────────────────────────────────────────────────
# A project's ekos.toml names the environment variable holding its key, never the key. Set the
# variables your projects name. Calls to a hosted model are billed by that provider.
# ANTHROPIC_API_KEY=
