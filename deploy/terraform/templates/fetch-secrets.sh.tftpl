#!/bin/bash
# ekos-fetch-secrets (RFC 0232): read the deployment's secrets from the cloud's secret store
# with the VM's own identity and write each as a file named after its variable, on tmpfs:
# /run/ekos-secrets/<console|git-sync>/<NAME>, owned by uid 1000, mode 0400. Nothing is logged
# but names. Runs before every start of ekos.service, so a rotated secret takes effect on restart.
set -euo pipefail
umask 077
ROOT=/run/ekos-secrets
rm -rf "$ROOT"
mkdir -p "$ROOT/console" "$ROOT/git-sync"

%{ if cloud == "azure" ~}
TOKEN=$(curl -sf -H Metadata:true \
  "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net&client_id=${azure_client_id}" \
  | jq -r .access_token)
fetch() {
  curl -sf -H "Authorization: Bearer $TOKEN" \
    "${azure_vault_uri}secrets/$1?api-version=7.4" | jq -j .value
}
%{ endif ~}
%{ if cloud == "gcp" ~}
TOKEN=$(curl -sf -H Metadata-Flavor:Google \
  "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
  | jq -r .access_token)
fetch() {
  curl -sf -H "Authorization: Bearer $TOKEN" \
    "https://secretmanager.googleapis.com/v1/$1/versions/latest:access" \
    | jq -r .payload.data | base64 -d
}
%{ endif ~}
%{ if cloud == "aws" ~}
IMDS=http://169.254.169.254
IMDS_TOKEN=$(curl -sf -X PUT -H "X-aws-ec2-metadata-token-ttl-seconds: 300" "$IMDS/latest/api/token")
ROLE=$(curl -sf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" "$IMDS/latest/meta-data/iam/security-credentials/")
CREDS=$(curl -sf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" "$IMDS/latest/meta-data/iam/security-credentials/$ROLE")
AKID=$(jq -r .AccessKeyId <<<"$CREDS")
SECRET=$(jq -r .SecretAccessKey <<<"$CREDS")
SESSION=$(jq -r .Token <<<"$CREDS")
fetch() {
  # Secrets Manager's JSON API, signed with SigV4 by curl itself (curl >= 7.75).
  curl -sf --aws-sigv4 "aws:amz:${aws_region}:secretsmanager" --user "$AKID:$SECRET" \
    -H "x-amz-security-token: $SESSION" \
    -H "X-Amz-Target: secretsmanager.GetSecretValue" \
    -H "Content-Type: application/x-amz-json-1.1" \
    -d "{\"SecretId\":\"$1\"}" \
    "https://secretsmanager.${aws_region}.amazonaws.com/" | jq -j .SecretString
}
%{ endif ~}

put() {  # put <group> <NAME> <reference>
  local file="$ROOT/$1/$2"
  if ! fetch "$3" > "$file"; then
    echo "ekos-fetch-secrets: could not read $2" >&2
    exit 1
  fi
  echo "ekos-fetch-secrets: $1/$2"
}

%{ for s in secrets ~}
put ${s.group} ${s.name} '${s.ref}'
%{ endfor ~}

%{ if azure_registry != "" ~}
# A private Azure Container Registry, with the same identity (no registry password anywhere): the
# identity's ARM token is exchanged for an ACR refresh token, which docker keeps in root's config
# for the `compose pull` that follows. Renewed at every start, like the secrets.
ARM_TOKEN=$(curl -sf -H Metadata:true \
  "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fmanagement.azure.com%2F&client_id=${azure_client_id}" \
  | jq -r .access_token)
REFRESH=$(curl -sf -X POST "https://${azure_registry}/oauth2/exchange" \
  --data-urlencode grant_type=access_token \
  --data-urlencode service=${azure_registry} \
  --data-urlencode "access_token=$ARM_TOKEN" | jq -r .refresh_token)
printf '%s' "$REFRESH" | docker login ${azure_registry} \
  --username 00000000-0000-0000-0000-000000000000 --password-stdin >/dev/null
echo "ekos-fetch-secrets: signed in to ${azure_registry}"
%{ endif ~}

chown -R 1000:1000 "$ROOT"
chmod 0500 "$ROOT/console" "$ROOT/git-sync"
chmod 0400 "$ROOT"/console/* "$ROOT"/git-sync/* 2>/dev/null || true
