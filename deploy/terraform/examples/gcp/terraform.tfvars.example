project_id = "my-project"
region     = "europe-west3"
compute    = "vm" # vm | container | kubernetes

# VM: SSH through IAP (`gcloud compute ssh ekos-vm --tunnel-through-iap`); the console is on
# https://<ip>.sslip.io unless you set a domain pointing at `vm_public_ip`.
# domain = "ekos.example.com"

# Sign-in with Google (an OAuth client of type "Web application"; redirect URI <url>/api/auth/callback).
oidc = {
  issuer    = "https://accounts.google.com"
  client_id = "<client-id>.apps.googleusercontent.com"
  scopes    = "openid email profile"
}
owners = "you@example.com"
# oidc_client_secret = set with TF_VAR_oidc_client_secret
# secrets            = set with TF_VAR_secrets='{"OPENAI_API_KEY":"sk-..."}'

git_repos = [
  "shop=https://github.com/acme/shop.git#main",
]
# git_token = set with TF_VAR_git_token
