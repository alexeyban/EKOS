# Copy this to marketing/.env and fill in real values — marketing/.env is
# gitignored and loaded automatically by `ekos marketing publish` (never
# overrides a variable already exported in the real shell environment).
#
# NEVER paste real values into a chat/terminal transcript that gets logged —
# export/edit this file directly, or set the vars in your own shell profile.

# X (Twitter) Developer Portal -> your app -> Keys and tokens.
# Requires OAuth 1.0a, App permissions = "Read and write" (regenerate the
# Access Token & Secret below if you changed permissions *after* first
# generating them — X does not retroactively upgrade already-issued tokens).
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# LLM provider for tweet drafting (see [llm] in ekos.toml — only needed here
# if you want to override what's already configured there).
# ANTHROPIC_API_KEY=
