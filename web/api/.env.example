# EKOS console API — local credentials. Copy to `.env` (gitignored) and edit.
#
#   cp api/.env.example api/.env
#
# One file serves both ways of running the console:
#   - `uv run uvicorn app.main:create_app --factory --reload` from `web/api` (pydantic reads it)
#   - `docker compose up` from `web/` (Compose injects it; never copied into the image)
#
# The prefix is `EKOS_CONSOLE_` and the setting is `console_token`, so the doubled word in
# `EKOS_CONSOLE_CONSOLE_TOKEN` is correct, not a typo.

# Read role.
EKOS_CONSOLE_CONSOLE_TOKEN=dev-read

# Read + write role: running pipeline commands, scheduling. Leave EMPTY to keep the console
# read-only — the API never grants write in token mode when this is unset, which is the safe
# default rather than an oversight.
EKOS_CONSOLE_CONSOLE_WRITE_TOKEN=dev-write

# Signs the session cookie. Change it for anything beyond localhost; `openssl rand -hex 16`.
EKOS_CONSOLE_SESSION_SECRET=dev-session-secret-change-me

# Path to the `ekos` binary the job runner and MCP supervisor execute.
# Local dev: relative to `web/api`. Under Compose this is overridden to the bind-mounted
# /usr/local/bin/ekos, because a relative path would not resolve inside the container.
EKOS_BIN=../../ekos/target/release/ekos

# Static bearer tokens are for local development. For anything shared, use OIDC instead
# (EKOS_CONSOLE_OIDC_ISSUER + _OIDC_CLIENT_ID/_OIDC_CLIENT_SECRET/_OIDC_ROLE_CLAIM/
# _OIDC_WRITE_VALUES); setting an issuer disables token login entirely.
